+using Json = nlohmann::json;
+inline bool active = false;
+inline Json materialized = Json::array();
+
+inline Json config(const DynamicPrintConfig &value)
+{
+    Json result = Json::object();
+    for (const auto &key : value.keys()) {
+        const ConfigOption &option = *value.option(key);
+        result[key] = {{"type", static_cast<int>(option.type())},
+                       {"serialized", option.serialize()}};
+    }
+    return result;
+}
+
+inline Json preset(const Preset &value)
+{
+    return {{"name", value.name}, {"system", value.is_system},
+            {"default", value.is_default}, {"external", value.is_external},
+            {"project_local", value.is_project_embedded},
+            {"visible", value.is_visible}, {"dirty", value.is_dirty},
+            {"filament_id", value.filament_id}, {"version", value.version.to_string()},
+            {"renamed_from", value.renamed_from}, {"config", config(value.config)}};
+}
+
+inline Json collection(const PresetCollection &value)
+{
+    Json records = Json::array();
+    for (const Preset &entry : value.get_presets())
+        records.push_back(preset(entry));
+    return {{"selected", preset(value.get_selected_preset())},
+            {"edited", preset(value.get_edited_preset())},
+            {"dirty", value.current_is_dirty()},
+            {"dirty_options", value.current_dirty_options()}, {"records", records}};
+}
+
+// PresetBundle.cpp:5470-5482; Config.cpp:1557-1605; bbs_3mf.cpp:8199-8204.
+inline std::string full_fff_config(const PresetBundle &value)
+{
+    const DynamicPrintConfig cfg = value.full_config_secure();
+    std::ostringstream result;
+    cfg.save_to_json(result, "project_settings", "project", SLIC3R_VERSION);
+    return result.str();
+}
+
+inline Json bundle(const PresetBundle &value)
+{
+    return {{"process", collection(value.prints)},
+            {"printer", collection(value.printers)},
+            {"filament", collection(value.filaments)},
+            {"filament_presets", value.filament_presets},
+            {"project_config", config(value.project_config)},
+            {"full_fff_config", full_fff_config(value)}};
+}
