+// WebGuideDialog.cpp:1053-1094: the printer model GuideFrame::apply_config prefers in a vendor bundle.
+inline std::string preferred_printer_model(PresetBundle &presets, const AppConfig::VendorMap &enabled_vendors,
+                                           const AppConfig::VendorMap &old_enabled_vendors,
+                                           const std::string &bundle_name, std::string &variant)
+{
+    const auto config = enabled_vendors.find(bundle_name);
+    if (config == enabled_vendors.end())
+        return std::string();
+    const VendorProfile &printer_profile = presets.vendors[bundle_name];
+    for (const auto &model_it : config->second) {
+        if (model_it.second.size() > 0) {
+            variant = *model_it.second.begin();
+            if (model_it.second.size() > 1) {
+                if (printer_profile.models.size() > 0) {
+                    const VendorProfile::PrinterModel &printer_model = *std::find_if(
+                        printer_profile.models.begin(), printer_profile.models.end(),
+                        [id = model_it.first](auto &m) { return m.id == id; });
+                    for (auto &vt : printer_model.variants) {
+                        if (std::find(model_it.second.begin(), model_it.second.end(), vt.name) != model_it.second.end()) {
+                            variant = vt.name;
+                            break;
+                        }
+                    }
+                } else if (variant != PresetBundle::ORCA_DEFAULT_PRINTER_VARIANT) {
+                    if (std::find(model_it.second.begin(), model_it.second.end(), PresetBundle::ORCA_DEFAULT_PRINTER_VARIANT) != model_it.second.end())
+                        variant = PresetBundle::ORCA_DEFAULT_PRINTER_VARIANT;
+                }
+            }
+            const auto config_old = old_enabled_vendors.find(bundle_name);
+            if (config_old == old_enabled_vendors.end())
+                return model_it.first;
+            const auto model_it_old = config_old->second.find(model_it.first);
+            if (model_it_old == config_old->second.end())
+                return model_it.first;
+            else if (model_it_old->second != model_it.second) {
+                for (const auto &var : model_it.second)
+                    if (model_it_old->second.find(var) == model_it_old->second.end()) {
+                        variant = var;
+                        return model_it.first;
+                    }
+            }
+        }
+    }
+    if (!variant.empty())
+        variant.clear();
+    return std::string();
+}
+
+// GuideFrame::run (WebGuideDialog.cpp:1223) and GuideFrame::apply_config (WebGuideDialog.cpp:1005-1205) confirmed
+// with `added` checked ({vendor: {model: [variant]}}) besides the installed models; the filament section stays
+// the app's (GuideFrame::SaveProfileData, WebGuideDialog.cpp:1693-1695).
+inline void wizard(PresetBundle &presets, AppConfig &app, const Json &added)
+{
+    presets.export_selections(app);
+    const AppConfig::VendorMap old_enabled_vendors = app.vendors();
+    AppConfig::VendorMap enabled_vendors = old_enabled_vendors;
+    for (auto vendor = added.begin(); vendor != added.end(); ++vendor)
+        for (auto model = vendor.value().begin(); model != vendor.value().end(); ++model)
+            for (const Json &variant : model.value())
+                enabled_vendors[vendor.key()][model.key()].insert(variant.get<std::string>());
+    const auto enabled_filaments = app.has_section(AppConfig::SECTION_FILAMENTS) ?
+                                       app.get_section(AppConfig::SECTION_FILAMENTS) :
+                                       std::map<std::string, std::string>();
+    std::string preferred_variant;
+    std::string preferred_model = preferred_printer_model(presets, enabled_vendors, old_enabled_vendors,
+                                                          PresetBundle::ORCA_DEFAULT_BUNDLE, preferred_variant);
+    if (preferred_model.empty())
+        for (const auto &bundle : enabled_vendors) {
+            if (bundle.first == PresetBundle::ORCA_DEFAULT_BUNDLE)
+                continue;
+            preferred_model = preferred_printer_model(presets, enabled_vendors, old_enabled_vendors, bundle.first,
+                                                      preferred_variant);
+            if (!preferred_model.empty())
+                break;
+        }
+    if (!presets.apply_vendor_config(enabled_vendors, enabled_filaments, &app, true, preferred_model,
+                                     preferred_variant))
+        throw std::runtime_error("apply_vendor_config failed");
+}
+
+// A pick in a sidebar combo after the load: the collection selection of Tab::select_preset (Tab.cpp:7701-7714)
+// for the printer and the process; PresetBundle::set_filament_preset for a filament slot
+// (Plater::priv::on_select_preset), and the tab's selection for a single filament.
+inline void select(PresetBundle &presets, AppConfig &app, const Json &selection)
+{
+    if (selection.contains("printer")) {
+        const int extruders_count = presets.get_printer_extruder_count();
+        presets.printers.select_preset_by_name(selection.at("printer").get<std::string>(), false);
+        presets.update_compatible(PresetSelectCompatibleType::Always, PresetSelectCompatibleType::Always);
+        // Tab::select_preset (Tab.cpp:7740-7742): with remember_printer_config, on by default (AppConfig.cpp:544-545),
+        // PresetBundle::update_selections (PresetBundle.cpp:3914-4017) restores the print, filaments and colours the
+        // AppConfig remembers for the printer, then runs update_compatible and update_multi_material_filament_presets
+        // (4002-4003); the session AppConfig is never loaded, so the printer is never used.
+        if (app.get_bool("remember_printer_config"))
+            presets.update_selections(app);
+        // Tab::load_current_preset (Tab.cpp:7744, 7248) runs TabPrinter::on_preset_loaded: a nozzle_diameter count
+        // other than the tab's extruder count (Tab.cpp:6455-6460) runs TabPrinter::extruders_count_changed
+        // (Tab.cpp:5866-5872), PresetBundle::on_extruders_count_changed (PresetBundle.cpp:8590-8595), which pads
+        // filament_presets to min_filament_count() in update_multi_material_filament_presets (PresetBundle.cpp:8598-8617).
+        if (presets.get_printer_extruder_count() != extruders_count)
+            presets.on_extruders_count_changed(presets.get_printer_extruder_count());
+    }
+    if (selection.contains("process")) {
+        presets.prints.select_preset_by_name(selection.at("process").get<std::string>(), false);
+        presets.update_compatible(PresetSelectCompatibleType::Never, PresetSelectCompatibleType::Always);
+    }
+    if (selection.contains("filaments")) {
+        size_t slot = 0;
+        for (const Json &name : selection.at("filaments"))
+            presets.set_filament_preset(slot++, name.get<std::string>());
+        if (presets.filament_presets.size() == 1)
+            presets.filaments.select_preset_by_name(presets.filament_presets.front(), false);
+    }
+}
+
+// A sidebar edit of the process after the picks: ConfigOptionsGroup::on_change_OG writes the value into the tab's
+// config, the edited preset (OptionsGroup.cpp:694-730, Tab.cpp:775); the option group's callback then runs
+// Tab::update_dirty (Tab.cpp:9711-9718, 1601-1613), which updates the collection's dirty state (Preset.cpp:4072).
+inline void edit_process(PresetBundle &presets, const Json &edit)
+{
+    for (auto option = edit.begin(); option != edit.end(); ++option)
+        presets.prints.get_edited_preset().config.set_deserialize_strict(option.key(), option.value().get<std::string>());
+    presets.prints.update_dirty();
+}
+
+inline int run(const char *request_path)
+{
+    try {
+        std::ifstream input(request_path);
+        Json request;
+        input >> request;
+        set_data_dir(request.at("data_directory").get<std::string>());
+        AppConfig app;
+        PresetBundle presets;
+        std::string errors;
+        presets.load_presets(app, ForwardCompatibilitySubstitutionRule::Disable,
+                             PresetBundle::PresetPreferences(), &errors, true);
+        if (!errors.empty())
+            throw std::runtime_error(errors);
+        Json result = {{"upstream", "40ecc66f78ed72dc368e0c1ebe40d77f00cc8a19"},
+                       {"before", bundle(presets)}, {"projects", Json::array()}};
+        if (request.contains("resources_directory"))
+            set_resources_dir(request.at("resources_directory").get<std::string>());
+        active = true;
+        for (const Json &project : request.at("projects")) {
+            DynamicPrintConfig combined = DynamicPrintConfig::full_print_config();
+            for (auto it = project.at("options").begin(); it != project.at("options").end(); ++it)
+                combined.set_deserialize_strict(it.key(), it.value().get<std::string>());
+            const std::string filename = project.at("filename").get<std::string>();
+            if (!boost::algorithm::iends_with(filename, ".3mf"))
+                throw std::runtime_error("preset-select probe requires a 3MF filename");
+            const Json imported = config(combined);
+            materialized = Json::array();
+            presets.load_config_model(filename, std::move(combined),
+                                      Semver(project.at("version").get<std::string>()));
+            GUI::sync_loaded_project_filament_config(presets.project_config);
+            Json record = {{"filename", filename}, {"imported", imported},
+                           {"materialized", materialized}};
+            if (project.contains("wizard") || project.contains("select") || project.contains("process_edit")) {
+                record["opened"] = bundle(presets);
+                if (project.contains("wizard"))
+                    wizard(presets, app, project.at("wizard"));
+                if (project.contains("select"))
+                    select(presets, app, project.at("select"));
+                if (project.contains("process_edit"))
+                    edit_process(presets, project.at("process_edit"));
+            }
+            record["result"] = bundle(presets);
+            result["projects"].push_back(std::move(record));
+        }
+        const std::string output_path = request.at("output").get<std::string>();
+        FILE *output = std::fopen(output_path.c_str(), "wx");
+        if (output == nullptr)
+            throw std::runtime_error("cannot create preset-select output");
+        const std::string bytes = result.dump(2) + "\n";
+        const size_t written = std::fwrite(bytes.data(), 1, bytes.size(), output);
+        const int closed = std::fclose(output);
+        if (written != bytes.size() || closed != 0)
+            throw std::runtime_error("cannot write preset-select output");
+        return 0;
+    } catch (const std::exception &error) {
+        std::cerr << "preset-select: " << error.what() << '\n';
+        return 1;
+    }
+}
+} // namespace Slic3r::PresetSelectProbe
