diff --git a/src/OrcaSlicer.cpp b/src/OrcaSlicer.cpp
index 271759b5e..e6003eee0 100644
--- a/src/OrcaSlicer.cpp
+++ b/src/OrcaSlicer.cpp
@@ -7533,6 +7533,92 @@ extern "C" {
 #else /* _MSC_VER */
 int main(int argc, char **argv)
 {
+    for (int i = 1; i < argc; ++i) {
+        if (strcmp(argv[i], "--process-gcode") == 0 && i + 1 < argc) {
+            Slic3r::GCodeProcessor processor;
+            Slic3r::PrintConfig config;
+            config.gcode_flavor.value = Slic3r::gcfMarlinLegacy;
+            config.filament_diameter.values = { 1.75f };
+            config.filament_type.values = { "PLA" };
+            config.nozzle_diameter.values = { 0.4f };
+            config.single_extruder_multi_material.value = false;
+            // ksr X2D machine caps (project_settings.config) so the
+            // extruding/retract/travel caps match the real flow.
+            config.machine_max_acceleration_extruding.values = { 20000.f, 20000.f, 20000.f };
+            config.machine_max_acceleration_retracting.values = { 30000.f, 5000.f, 30000.f };
+            config.machine_max_acceleration_travel.values = { 9000.f, 9000.f, 9000.f };
+            // Explicit fixture tool count; existing invocations keep their config.
+            for (int j = 1; j + 1 < argc; ++j) {
+                if (strcmp(argv[j], "--colorchange-tools") != 0)
+                    continue;
+                const int count = atoi(argv[j + 1]);
+                if (count < 1 || count > 256)
+                    return 1;
+                config.filament_diameter.values.assign(count, 1.75);
+                config.filament_density.values.assign(count, 1.24);
+                config.filament_type.values.assign(count, "PLA");
+                config.filament_colour.values.assign(count, "#F2754E");
+                config.nozzle_diameter.values.assign(count, 0.4);
+            }
+            processor.apply_config(config);
+            processor.process_file(argv[i + 1]);
+            const auto& result = processor.get_result();
+            for (int m = 0; m < static_cast<int>(PrintEstimatedStatistics::ETimeMode::Count); ++m) {
+                auto mode = static_cast<PrintEstimatedStatistics::ETimeMode>(m);
+                if (result.print_statistics.modes[(size_t)mode].time > 0.0f)
+                    printf("TIME mode=%d total=%f\n", m, result.print_statistics.modes[(size_t)mode].time);
+            }
+            // --dump-moves <csv>: GCodeProcessorResult::moves oracle for
+            // the Ares move recorder (M853). %.9g round-trips every f32.
+            for (int j = 1; j + 1 < argc; ++j) {
+                if (strcmp(argv[j], "--dump-moves") != 0)
+                    continue;
+                FILE* out = fopen(argv[j + 1], "w");
+                if (out == nullptr)
+                    return 1;
+                fprintf(out, "gcode_id,type,role,extruder_id,cp_color_id,x,y,z,delta_extruder,feedrate,width,height,"
+                             "mm3_per_mm,travel_dist,fan_speed,temperature,time0,layer_id,internal_only\n");
+                for (const auto& v : result.moves)
+                    fprintf(out, "%u,%d,%d,%d,%d,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%u,%d\n",
+                            v.gcode_id, static_cast<int>(v.type), static_cast<int>(v.extrusion_role),
+                            static_cast<int>(v.extruder_id), static_cast<int>(v.cp_color_id),
+                            v.position.x(), v.position.y(), v.position.z(), v.delta_extruder, v.feedrate,
+                            v.width, v.height, v.mm3_per_mm, v.travel_dist, v.fan_speed, v.temperature,
+                            v.time[0], v.layer_id, v.internal_only ? 1 : 0);
+                fclose(out);
+            }
+            // Raw public processor records, not GCodeViewer's unchecked join.
+            for (int j = 1; j + 1 < argc; ++j) {
+                if (strcmp(argv[j], "--dump-color-change") != 0)
+                    continue;
+                nlohmann::json data = {
+                    {"volumes_per_color_change", result.print_statistics.volumes_per_color_change},
+                    {"extruder_colors", result.extruder_colors},
+                    {"filament_diameters", result.filament_diameters},
+                    {"filament_densities", result.filament_densities},
+                    {"custom_gcode_per_print_z", nlohmann::json::array()},
+                    {"custom_gcode_times", nlohmann::json::array()}
+                };
+                for (const auto& item : result.custom_gcode_per_print_z)
+                    data["custom_gcode_per_print_z"].push_back({
+                        {"type", static_cast<int>(item.type)}, {"extruder", item.extruder},
+                        {"print_z", item.print_z}, {"color", item.color}, {"extra", item.extra}
+                    });
+                const auto& normal = result.print_statistics.modes[0];
+                data["normal_time"] = normal.time;
+                for (const auto& [type, times] : normal.custom_gcode_times)
+                    data["custom_gcode_times"].push_back({
+                        {"type", static_cast<int>(type)},
+                        {"duration", times.first}, {"remaining", times.second}
+                    });
+                std::ofstream out(argv[j + 1]);
+                out << data.dump(2) << '\n';
+                if (!out)
+                    return 1;
+            }
+            return 0;
+        }
+    }
 #ifndef _WIN32
     // Ignore SIGPIPE so a write to a closed socket (e.g. a dropped printer
     // network connection) returns EPIPE to the caller instead of terminating
